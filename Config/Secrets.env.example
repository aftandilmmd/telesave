# Copy to Config/Secrets.env (git-ignored) to bundle your Telegram API key into release builds.
# Get it from https://my.telegram.org/apps. Leave empty to have users enter their own key on first run.
TG_API_ID=
TG_API_HASH=

# Remote config (optional): signed JSON that can rotate the API key and show announcements.
# URLs are tried in order: GitHub Pages first, own server as fallback. HTTPS only.
# Public key comes from: swift scripts/remote-config.swift keygen
TG_CONFIG_URLS="https://<user>.github.io/telesave-config/config.json,https://<your-server>/telesave/config.json"
TG_CONFIG_PUBLIC_KEY=

# In-place updates (Sparkle). Create the key pair once: .build/artifacts/sparkle/Sparkle/bin/generate_keys
# (the private key stays in your login keychain; scripts/make-dmg.sh uses it to sign appcast.xml).
# Paste the printed public key here. Empty: the Update button downloads the DMG instead.
SPARKLE_PUBLIC_KEY=
