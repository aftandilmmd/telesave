<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TeleSave.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The macOS app's translation files, shared as-is: a new language file serves both apps. -->
    <Content Include="..\..\..\Sources\TeleSaveCore\Resources\Localization\*.json" Link="Localization\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TeleSave.Core.Tests" />
  </ItemGroup>
</Project>
