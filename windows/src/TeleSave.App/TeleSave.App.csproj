<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Clipboard images and associated file icons. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TeleSave</AssemblyName>
    <RootNamespace>TeleSave.App</RootNamespace>
    <ApplicationIcon>TeleSave.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TeleSave.UI\TeleSave.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="TeleSave.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- WinForms is only used fully qualified (clipboard, icons); its names clash with Avalonia's. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <!-- Optional build-time API key and remote config (CI passes them from secrets). -->
  <ItemGroup>
    <AssemblyMetadata Include="TSApiID" Value="$(TG_API_ID)" />
    <AssemblyMetadata Include="TSApiHash" Value="$(TG_API_HASH_OBF)" />
    <AssemblyMetadata Include="TSConfigURLs" Value="$(TG_CONFIG_URLS)" />
    <AssemblyMetadata Include="TSConfigPublicKey" Value="$(TG_CONFIG_PUBLIC_KEY)" />
  </ItemGroup>
</Project>
